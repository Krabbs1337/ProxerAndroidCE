<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly"
    tools:ignore="UnusedAttribute">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <queries>
        <package android:name="com.crunchyroll.crunchyroid" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.android.vending" />

        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:appCategory="social"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.Placeholder.App.Splash"
        tools:ignore="UnusedAttribute"
        tools:replace="android:supportsRtl">

        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="true" />

        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="me.proxer.app.anime.stream.CastOptionsProvider" />

        <activity android:name=".MainActivity" android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter
                android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/news" />
                <data
                    android:scheme="http" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/news" />
                <data
                    android:scheme="https" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/anime" />
                <data
                    android:scheme="http" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/anime" />
                <data
                    android:scheme="https" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/anime/.*" />
                <data
                    android:scheme="http" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/anime/.*" />
                <data
                    android:scheme="https" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/calendar" />
                <data
                    android:scheme="http" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/calendar" />
                <data
                    android:scheme="https" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/manga" />
                <data
                    android:scheme="http" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/manga" />
                <data
                    android:scheme="https" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/manga/.*" />
                <data
                    android:scheme="http" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/manga/.*" />
                <data
                    android:scheme="https" />

            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity android:name=".profile.ProfileActivity" android:exported="true">

            <intent-filter
                android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/user/.*" />
                <data
                    android:scheme="http" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/user/.*" />
                <data
                    android:scheme="https" />

            </intent-filter>
        </activity>

        <activity android:name=".notification.NotificationActivity" />

        <activity android:name=".profile.settings.ProfileSettingsActivity" />

        <activity
            android:name=".comment.EditCommentActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".media.MediaActivity" android:exported="true">

            <intent-filter
                android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/info/.*" />
                <data
                    android:scheme="http" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/info/.*" />
                <data
                    android:scheme="https" />

            </intent-filter>
        </activity>

        <activity android:name=".info.translatorgroup.TranslatorGroupActivity" />

        <activity android:name=".info.industry.IndustryActivity" />

        <activity
            android:name=".ui.ImageDetailActivity"
            android:theme="@style/Theme.Placeholder.App.Splash.NoBackground" />

        <activity
            android:name=".anime.stream.StreamActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:launchMode="singleTask" />

        <activity android:name=".manga.MangaActivity" android:exported="true">
            <intent-filter
                android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/chapter/.*" />
                <data
                    android:scheme="http" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/chapter/.*" />
                <data
                    android:scheme="https" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/read/.*" />
                <data
                    android:scheme="http" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/read/.*" />
                <data
                    android:scheme="https" />

            </intent-filter>
        </activity>

        <activity android:name=".anime.AnimeActivity" android:exported="true">
            <intent-filter
                android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/watch/.*" />
                <data
                    android:scheme="http" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/watch/.*" />
                <data
                    android:scheme="https" />

            </intent-filter>
        </activity>

        <activity android:name=".forum.TopicActivity" android:exported="true">
            <intent-filter
                android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/forum/.*/.*" />
                <data
                    android:scheme="http" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/forum/.*/.*" />
                <data
                    android:scheme="https" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/touzai" />
                <data
                    android:scheme="http" />

                <data
                    android:host="proxer.me" />
                <data
                    android:pathPattern="/touzai" />
                <data
                    android:scheme="https" />

            </intent-filter>
        </activity>

        <activity android:name=".settings.status.ServerStatusActivity" android:exported="true">
            <intent-filter
                android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="proxer.de" />
                <data
                    android:scheme="http" />

                <data
                    android:host="proxer.de" />
                <data
                    android:scheme="https" />

            </intent-filter>
        </activity>

        <activity android:name=".settings.ProxerLibsActivity" />

        <activity android:name=".ui.WebViewActivity" android:exported="true" />

        <activity
            android:name=".introduction.IntroductionActivity"
            android:exported="false"
            android:theme="@style/Theme.Proxer.Introduction" />

        <service
            android:name=".news.widget.NewsWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".news.widget.NewsWidgetDarkService"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".anime.schedule.widget.ScheduleWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".anime.schedule.widget.ScheduleWidgetDarkService"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver
            android:name=".news.widget.NewsWidgetProvider"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/widget_news_label" android:exported="true">

            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_news" />
        </receiver>

        <receiver
            android:name=".news.widget.NewsWidgetDarkProvider"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/widget_news_label" android:exported="true">

            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_news_dark" />
        </receiver>

        <receiver
            android:name=".anime.schedule.widget.ScheduleWidgetProvider"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/widget_schedule_label" android:exported="true">

            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_schedule" />
        </receiver>

        <receiver
            android:name=".anime.schedule.widget.ScheduleWidgetDarkProvider"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/widget_schedule_label" android:exported="true">

            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_schedule_dark" />
        </receiver>

        <receiver
            android:name=".news.NewsNotificationReadReceiver"
            android:exported="false" />

        <receiver
            android:name=".notification.AccountNotificationReadReceiver"
            android:exported="false" />
    </application>
</manifest>
